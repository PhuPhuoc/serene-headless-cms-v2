    "label": {
      "type": "string",
      "required": true
    },
    "ctaVariant": {
      "type": "enumeration",
      "default": "none",
      "enum": [
        "none",
        "solid",
        "outline",
        "underline"
      ]
    },
    "ctaBehavior": {
      "type": "enumeration",
      "default": "internal",
      "enum": [
        "internal",
        "external",
        "modal"
      ]
    },
    "withIcon": {
      "type": "boolean",
      "required": false,
      "default": true
    },
    "modalKey": {
      "type": "enumeration",
      "enum": [
        "contactUs",
        "joinMembership"
      ]
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "url": {
      "type": "string"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    }
  },
  "config": {}
}
